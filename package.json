{
  "name": "studenv",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <24"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "node scripts/dev-entry.mjs",
    "preview": "next build && tsx server.ts --prod",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "tsx server.ts --prod",
    "db:check": "node scripts/check-db.mjs",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.mjs",
    "test:security": "tsx --test lib/security/request.test.ts lib/security/sanitize.test.ts lib/services/ai-generate.service.test.ts",
    "test:items": "tsx --test lib/utils/item-patch.test.ts",
    "test:refs": "tsx --test lib/refs/refs.test.ts lib/refs/extract/link-rows.test.ts",
    "test:flashcards": "tsx --test lib/flashcards/scheduler.test.ts",
    "test:notes": "tsx --test lib/notes/notes.test.ts lib/notes/note-storage.test.ts lib/notes/editor.test.ts lib/notes/legacy-text.test.ts",
    "test:workspace-pointer": "tsx --test lib/workspace/pointer-session.test.ts",
    "test:workspace-drawing": "tsx --test lib/workspace/drawing-geometry.test.ts",
    "test:workspace-image": "tsx --test lib/workspace/image-sizing.test.ts",
    "test:workspace-image-resize": "tsx --test lib/workspace/image-resize.test.ts",
    "test:workspace-connectors": "tsx --test lib/workspace/connector-geometry.test.ts lib/workspace/connector-lifecycle.test.ts lib/workspace/selection-frame.test.ts lib/workspace/connector-anchors.test.ts lib/workspace/connector-target.test.ts lib/workspace/connector-routing.test.ts lib/workspace/connector-path.test.ts lib/workspace/connector-label.test.ts lib/workspace/connector-autocomplete.test.ts lib/workspace/rotate-handles.test.ts lib/workspace/connector-selection.test.ts lib/workspace/connector-style.test.ts",
    "test:workspace-history": "tsx --test lib/workspace/workspace-history.test.ts lib/workspace/touch-history-gesture.test.ts",
    "test:workspace-context-menu": "tsx --test lib/workspace/context-menu.test.ts",
    "test:workspace-lock": "tsx --test lib/workspace/element-lock.test.ts",
    "test:workspace-resource-card": "tsx --test lib/workspace/resource-card.test.ts lib/workspace/note-card.test.ts",
    "test:workspace-forward-compat": "tsx --test lib/workspace/scene-forward-compat.test.ts",
    "test:ink": "tsx --test lib/ink/ink.test.ts",
    "test:workspace": "npm run test:workspace-pointer && npm run test:workspace-drawing && npm run test:workspace-image && npm run test:workspace-image-resize && npm run test:workspace-connectors && npm run test:workspace-history && npm run test:workspace-context-menu && npm run test:workspace-lock && npm run test:workspace-resource-card && npm run test:workspace-forward-compat && npm run test:ink"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@google/generative-ai": "^0.24.1",
    "@mozilla/readability": "^0.5.0",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@tiptap/core": "3.20.4",
    "@tiptap/extension-details": "3.20.4",
    "@tiptap/extension-highlight": "3.20.4",
    "@tiptap/extension-link": "3.20.4",
    "@tiptap/extension-list": "3.20.4",
    "@tiptap/extension-mathematics": "3.20.4",
    "@tiptap/extension-mention": "3.20.4",
    "@tiptap/extension-table": "3.20.4",
    "@tiptap/extension-text-style": "3.20.4",
    "@tiptap/extension-unique-id": "3.20.4",
    "@tiptap/extensions": "3.20.4",
    "@tiptap/pm": "3.20.4",
    "@tiptap/react": "3.20.4",
    "@tiptap/starter-kit": "3.20.4",
    "@tiptap/suggestion": "3.20.4",
    "@tldraw/tldraw": "^4.5.3",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^2.0.1",
    "argon2": "^0.41.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^2.18.0",
    "jose": "^6.0.8",
    "jsdom": "^26.0.0",
    "katex": "0.16.47",
    "lucide-react": "^0.468.0",
    "next": "14.2.25",
    "next-auth": "5.0.0-beta.25",
    "nodemailer": "^6.10.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.1",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
    "react-resizable-panels": "^4.10.0",
    "react-rnd": "^10.5.3",
    "react-zoom-pan-pinch": "^3.7.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.3.0",
    "youtube-transcript": "^1.3.1",
    "yt-dlp-exec": "^1.0.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.25",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
